# Wwebjs session health check
WWEBJS_API_URL=http://localhost:727
WWEBJS_HEALTH_CHECK_ENABLED=false
WWEBJS_HEALTH_CHECK_CRON=*/30 * * * *
WWEBJS_HEALTH_PROBE_TIMEOUT_MS=60000
WWEBJS_HEALTH_PROBE_POLL_MS=5000
WWEBJS_HEALTH_RESULT_TTL_MS=2700000
# Client oficial WABA que recebe a solicitacao do PRIMARY e so entao responde sem template.
# Deve usar um telefone diferente do grupo PRIMARY/SHADOW.
WWEBJS_HEALTH_OFFICIAL_CLIENT_ID=   # ID do client WABA no whatsapp-service
# Alias legado ainda aceito: WWEBJS_HEALTH_CHECK_CLIENT_ID

# Entrega assincrona e idempotente de mensagens de grupos internos
REMOTE_MESSAGE_JOB_REQUEST_TIMEOUT_MS=10000
REMOTE_MESSAGE_JOB_REQUEST_MAX_ATTEMPTS=3
INTERNAL_WPP_QUEUE_INTERVAL_MS=500
INTERNAL_WPP_JOB_POLL_INTERVAL_MS=1500
INTERNAL_WPP_QUEUE_LOCK_DURATION_MS=30000
INTERNAL_WPP_QUEUE_RETENTION_DAYS=30

# Inbox duravel de eventos inbound recebidos do wwebjs-api
REMOTE_INBOUND_EVENT_INTERVAL_MS=250
REMOTE_INBOUND_EVENT_LOCK_MS=60000
# Eventos aceitos com ACK 202 são repetidos indefinidamente até completar.

# Painel local de migração de instâncias legadas
