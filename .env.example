PUSH_NOTIFICATIONS_SECRET=
LISTEN_PORT=8005
PUBLIC_BI_RATE_LIMIT_MAX_REQUESTS=50
PUBLIC_BI_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_BI_MAX_CONCURRENT_REQUESTS=4
WHATSAPP_DATABASE_URL="mysql://root:9231@localhost:3306/whatsapp?schema=public&connection_limit=5&pool_timeout=20"
# Caminho absoluto recomendado em producao; tambem e espelhado no stderr/PM2.
DATABASE_INCIDENT_LOG_PATH=./logs/database-incidents.log
# Protege o disco durante uma indisponibilidade longa; stderr/PM2 continua recebendo eventos.
DATABASE_INCIDENT_LOG_MAX_BYTES=10485760
# Ativo por padrao em Linux/PM2; coleta automatica limitada apos incidentes Prisma.
DATABASE_INCIDENT_AUTO_CAPTURE=true
DATABASE_OPERATION_METRICS=true
DATABASE_SLOW_OPERATION_MS=1000
# Relativo ao cwd do PM2; em producao prefira um caminho absoluto persistente.
DATABASE_INCIDENT_CAPTURE_DIR=./logs/database-incidents
WHATSAPP_IGNORED_MESSAGE_TYPES=e2e_notification,notification_template,call_log,gp2
CACHE_PROVIDER="memory"

WWEBJS_BROWSER_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"

INSTANCES_API_URL="http://localhost:8000"
AUTH_API_URL="http://localhost:8001"
USERS_API_RL="http://localhost:8001"
FILES_API_URL="http://localhost:8003"
SOCKET_API_URL="http://localhost:8004"
AI_API_URL="http://localhost:8008"
MARKETING_API_URL="http://localhost:8007"

