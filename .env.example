# Dedicated application logs. Keep legacy until offline copy/verify/activate completes.
PROCESS_LOG_STORAGE=legacy
LOGS_DATABASE_URL=
PROCESS_LOG_POOL_SIZE=2
PROCESS_LOG_MAX_PENDING=20
PROCESS_LOG_RETENTION_SUCCESS_DAYS=7
PROCESS_LOG_RETENTION_FAILED_DAYS=30
PROCESS_LOG_CLEANUP_ENABLED=false
PROCESS_LOG_CLEANUP_CRON=0 19 * * *
PROCESS_LOG_CLEANUP_TIMEZONE=America/Sao_Paulo
PROCESS_LOG_CLEANUP_BATCH_SIZE=500
