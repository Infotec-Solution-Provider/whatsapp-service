{
	"name": "inpulse-whatsapp",
	"version": "0.0.1",
	"description": "Service that integrate inPulse with Whatsapp.",
	"main": "dist/main.js",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "ts-node-dev --transpile-only --respawn --ignore-watch node_modules --watch .env src/main.ts",
		"dev:frontend": "node scripts/build-frontend.js --watch",
		"start": "ts-node src/main.ts",
		"build": "npx tsc && cp ./.env ./dist/.env",
		"build:frontend": "node scripts/build-frontend.js",
		"build:frontend:watch": "node scripts/build-frontend.js --watch",
		"dev:instances": "cd ../instances-service && npm run dev",
		"dev:users": "cd ../users-service && npm run dev",
		"dev:customers": "cd ../customers-service && npm run dev",
		"dev:files": "cd ../files-service && npm run dev",
		"dev:socket": "cd ../socket-service && npm run dev",
		"dev:present": "cd ../inpulse-frontend && npm run dev",
		"start:all": "powershell -ExecutionPolicy Bypass -File scripts/start-all-services.ps1",
		"sync:local": "ts-node src/scripts/sync-local.ts",
		"sync:local:instance": "ts-node src/scripts/sync-local.ts",
		"logs:migrate": "ts-node src/scripts/migrate-logs.ts",
		"tenant:migrate": "ts-node src/scripts/tenant-migrate.ts",
		"test:log-storage": "ts-node src/logs/logs.test.ts",
		"test:log-storage:mysql": "ts-node src/logs/logs.mysql.test.ts",
		"migration:panel": "ts-node src/scripts/migration-panel.ts",
		"test:contact-identity": "ts-node src/utils/resolve-contact-identity.test.ts",
		"test:message-send-trace": "ts-node --files src/middlewares/message-send-trace.test.ts",
		"test:contact-registration": "ts-node src/services/contact-registration.test.ts",
		"test:functional-health": "ts-node src/services/wwebjs-health-check.service.test.ts && ts-node src/services/remote-session-stability.test.ts",
		"test:remote-inbound": "ts-node src/services/remote-inbound-event-inbox.test.ts",
		"test:internal-message-status": "ts-node src/services/internal-message-status.test.ts",
		"test:legacy-message-encoding": "ts-node src/services/messages-local-encoding.test.ts",
		"test:parameters": "ts-node src/services/parameters.service.test.ts",
		"test:edit-message-id": "ts-node src/utils/resolve-edit-message-id.test.ts",
		"test:operator-send": "ts-node src/utils/operator-send-request.test.ts && ts-node src/utils/operator-send-delivery.test.ts && ts-node src/utils/remote-send-file-options.test.ts && ts-node src/utils/operator-quoted-message.test.ts && ts-node src/services/operator-outbound.test.ts && npm run test:waba-send",
		"test:waba-send": "ts-node src/utils/waba-send.test.ts && ts-node src/whatsapp-client/waba-whatsapp-client.test.ts && ts-node src/services/message-send-error-presentation.test.ts && ts-node src/services/waba-legacy-send-status.test.ts && ts-node src/services/files-waba-media.test.ts",
		"test:reactions": "ts-node src/utils/message-reaction.test.ts && ts-node src/services/message-reactions.repository.test.ts && ts-node src/services/message-reactions.service.test.ts",
		"test:mentions": "ts-node src/utils/message-mention-metadata.test.ts && ts-node src/utils/message-mention-persistence.test.ts && ts-node src/services/message-mentions.service.test.ts && ts-node src/services/message-mentions-flow.test.ts",
		"test:pipeline-events": "ts-node src/services/pipeline-enrollment-disabled.test.ts",
		"test:resource-pressure": "ts-node src/services/durable-worker-concurrency.test.ts && ts-node src/services/webhook-worker-errors.test.ts && node --test scripts/capture-resource-incident.test.cjs",
		"test:database-incidents": "ts-node src/utils/database-operation-metrics.test.ts && ts-node src/utils/database-incident-log.test.ts && ts-node src/utils/database-incident-capture.test.ts && node --test scripts/capture-resource-incident.test.cjs",
		"test:public-api": "ts-node src/utils/public-message-direction.test.ts",
		"test:contact-action-requests:mysql": "node scripts/smoke-contact-action-requests.js",
		"fix:messages:chat-contact": "ts-node src/routines/fix-messages-chat-contact.routine.ts",
		"fix:messages:chat-contact:apply": "ts-node src/routines/fix-messages-chat-contact.routine.ts --apply",
		"backfill:internal-message-wwebjs-ids": "ts-node src/routines/backfill-internal-message-wwebjs-ids.routine.ts",
		"redis:start": "bash scripts/redis.sh start",
		"redis:stop": "bash scripts/redis.sh stop",
		"redis:restart": "bash scripts/redis.sh restart",
		"redis:logs": "bash scripts/redis.sh logs",
		"redis:cli": "bash scripts/redis.sh cli",
		"redis:stats": "bash scripts/redis.sh stats",
		"redis:keys": "bash scripts/redis.sh keys",
		"redis:clear": "bash scripts/redis.sh clear",
		"redis:monitor": "bash scripts/redis.sh monitor",
		"redis:ui": "bash scripts/redis.sh ui"
	},
	"author": "Renan G. Dutra",
	"license": "ISC",
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@in.pulse-crm/utils": "^1.3.0",
		"@mui/icons-material": "^7.3.4",
		"@mui/material": "^7.3.4",
		"@prisma/client": "^6.4.1",
		"@rgranatodutra/http-errors": "^1.0.7",
		"axios": "^1.8.4",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"express-async-errors": "^3.1.1",
		"fluent-ffmpeg": "^2.1.3",
		"form-data": "^4.0.4",
		"ioredis": "^5.8.1",
		"mime-types": "^3.0.1",
		"multer": "^1.4.5-lts.1",
		"mysql2": "^3.22.2",
		"node-cron": "^3.0.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"socket.io-client": "^4.8.1",
		"whatsapp-web.js": "^1.34.4"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/fluent-ffmpeg": "^2.1.27",
		"@types/ioredis": "^4.28.10",
		"@types/mime-types": "^2.1.4",
		"@types/multer": "^1.4.12",
		"@types/node-cron": "^3.0.11",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"esbuild": "^0.25.11",
		"prettier": "3.5.2",
		"prisma": "^6.10.1",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0"
	}
}
